# Copier en .env et renseigner. Le fichier .env est ignoré par Git.
# Nécessaire uniquement pour régénérer les verbatims via l'API Anthropic (python -m src.verbatims).
# Sans clé, le générateur local seedé est utilisé automatiquement.
ANTHROPIC_API_KEY=

# Facultatif — évaluer TabPFN 2.5 (python -m src.fondation_eval).
# Le dépôt de poids Hugging Face est public ; ce qui exige un jeton est l'acceptation de la
# licence PriorLabs (compte sur ux.priorlabs.ai, puis clé API). Sans ce jeton, TabICL et
# TabPFN v2 sont évalués et la 2.5 est déclarée indisponible avec sa cause exacte.
TABPFN_TOKEN=
